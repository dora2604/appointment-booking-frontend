{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/appointment-booking-client" }
    },
    {
      "src": "server/src/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server/src/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/client/dist/appointment-booking-client/$1" }
  ]
}
