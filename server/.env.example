# Local development defaults
HOST=0.0.0.0
PORT=5000

# Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origins
# Local: http://localhost:4200
# Render live: set this in the Render dashboard to your Vercel URL
CLIENT_ORIGIN=http://localhost:4200,https://your-vercel-app.vercel.app

# Storage mode
# false = Supabase only
# true = allow local JSON fallback when Supabase is unavailable
ALLOW_DEMO_STORAGE=false
