# Local development defaults
HOST=0.0.0.0
PORT=5000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=<app-name>

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origins
# Local: http://localhost:4200
# Render live: set this in the Render dashboard to your Vercel URL
CLIENT_ORIGIN=http://localhost:4200,https://your-vercel-app.vercel.app

# Storage mode
# false = MongoDB only
# true = allow local JSON fallback when Mongo is unavailable
ALLOW_DEMO_STORAGE=false
