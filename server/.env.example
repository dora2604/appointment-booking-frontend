# Local development defaults
HOST=0.0.0.0
PORT=5000

# Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth
JWT_SECRET=your-random-jwt-secret
JWT_EXPIRES_IN=7d

# Frontend origins
# Local: http://localhost:4200
# Render live: set this in the Render dashboard to your deployed frontend URL
CLIENT_ORIGIN=http://localhost:4200,https://appoinment-booking-system-2oen.vercel.app

# Storage mode
# false = Supabase only
# true = allow local JSON fallback when Supabase is unavailable
ALLOW_DEMO_STORAGE=false
